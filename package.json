{
	"private": true,
	"name": "notifications",
	"scripts": {
		"build": "nest build --webpack --webpackPath=./webpack.config",
        "setup": "npm i",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:migrate:dev": "prisma migrate dev",
        "db:migrate:rest": "prisma migrate reset",
        "generate": "prisma generate",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
	},
	"dependencies": {
		"axios": "^1.20.0",
        "@prisma/client": "6.8.2",
        "dotenv": "16.3.1",
        "@nestjs/common": "11.2.8",
        "@nestjs/core": "11.2.8",
        "@nestjs/mapped-types": "2.1.0",
        "@nestjs/platform-express": "11.2.8",
        "@nestjs/platform-socket.io": "11.2.8",
        "@nestjs/schedule": "6.0.0",
        "@nestjs/websockets": "11.2.8",
        "config": "^3.3.9",
        "cookie-parser": "^1.4.6",
        "install": "^0.13.0",
        "level": "7.0.0",
        "multiformats": "9.6.4",
        "@nats-io/transport-node": "^3.4.0",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.2.0",
        "varint": "6.0.0",
        "prisma": "6.8.2"
	  },
	  "devDependencies": {
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "11.0.9",
        "@nestjs/testing": "11.2.8",
        "@types/cookie-parser": "^1.4.3",
        "@types/express": "^4.17.13",
        "@types/jest": "29.2.4",
        "@types/node": "18.11.18",
        "add-asset-webpack-plugin": "2.0.1",
        "eslint": "^8.0.1",
        "fork-ts-checker-webpack-plugin": "^8.0.0",
        "jest": "29.3.1",
        "source-map-support": "^0.5.20",
        "ts-jest": "29.0.3",
        "ts-loader": "^9.4.2",
        "tsconfig-paths": "4.1.1",
        "webpack": "^5.104.1",
        "webpack-cli": "^5.0.1",
        "webpack-node-externals": "^3.0.0",
        "copy-webpack-plugin": "^11.0.0",
        "@typescript-eslint/eslint-plugin": "5.52.0",
        "@typescript-eslint/parser": "5.52.0",
        "eslint-config-prettier": "8.6.0",
        "eslint-plugin-prettier": "4.2.1",
        "eslint-plugin-vue": "^9.0.0",
        "husky": "8.0.3",
        "lint-staged": "13.1.2",
        "prettier": "^2.5.1",
        "ts-node": "10.0.0",
        "typescript": "^5.1.0"
	  },
	  "overrides": {
        "axios": "^1.20.0",
        "follow-redirects": "^1.16.2",
        "form-data": "^4.0.6",
        "fast-uri": "^3.1.9",
        "js-yaml@3": "3.15.2",
        "js-yaml@4": "4.3.2",
        "brace-expansion@1": "1.1.21",
        "brace-expansion@5": "5.0.12",
        "@isaacs/brace-expansion": ">=5.0.1",
        "minimatch@3": "3.1.5",
        "minimatch@10": "10.2.6",
        "lodash": ">=4.18.1",
        "flatted": "^3.4.2",
        "serialize-javascript": "^7.1.4",
        "@babel/core": "^7.29.6",
        "body-parser": "^2.4.0",
        "qs": "^6.16.1",
        "engine.io": "^6.6.11",
        "socket.io-parser": "^4.2.7",
        "ws": "^8.21.0",
        "picomatch@2": "2.3.2",
        "picomatch@4": "4.0.4",
        "diff": "^4.0.4",
        "ajv@6": "6.15.0",
        "ajv@8": "8.18.0",
        "yaml@1": "1.10.3",
        "yaml@2": "2.8.3",
        "multer": "^2.5.0",
        "postcss-selector-parser": "^7.1.7",
        "proxy-addr": "^2.0.8"
	  },
	  "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
